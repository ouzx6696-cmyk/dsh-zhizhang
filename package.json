{
  "name": "dsh-zhizhang",
  "version": "0.17.0",
  "description": "织章 DSH 插件：按需启用（默认只挂 zhizhang_enable）；Scheduler 调度；双轴 craft|mind；lean 写作闭环；反僵硬；写后可选编辑 A/B/C；小说阅读工作台；可选多草稿（默认关）；ports-only。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:check": "tsc -p tsconfig.json --noEmit && node scripts/build-client.mjs --check",
    "prepare": "npm run build",
    "test": "bun test test/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "zhizhang",
    "novel-writing",
    "writing-workflow",
    "style-linter",
    "ai-writing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
