{
  "name": "dsh-zhizhang",
  "version": "0.20.0",
  "description": "织章 DSH 插件：按需启用；参考分析与原创规划；条件接续、版本化审读、定稿与安全修订；本地资产、恢复与作者阅读工作台（写作台三栏、并排对照、确认式采纳 / 审读 / 定稿）。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/backup.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:check": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node scripts/build-client.mjs --check",
    "prepare": "npm run build",
    "test": "npm run build && node --test --import ./test/setup.mjs test/domain.test.mjs test/workflow.test.mjs test/storage.test.mjs test/panel.test.mjs",
    "check": "node scripts/architecture-guard.mjs && npm test",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "guard": "node scripts/architecture-guard.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "zhizhang",
    "novel-writing",
    "writing-workflow",
    "style-linter",
    "ai-writing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ouzx6696-cmyk/dsh-zhizhang.git"
  },
  "homepage": "https://github.com/ouzx6696-cmyk/dsh-zhizhang#readme",
  "bugs": {
    "url": "https://github.com/ouzx6696-cmyk/dsh-zhizhang/issues"
  }
}
