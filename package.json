{
  "name": "writer-agent",
  "version": "0.5.0",
  "private": true,
  "description": "写作 Agent：DSH 插件形态的番茄长篇 + 今日头条写作工具链",
  "type": "module",
  "engines": {
    "node": ">=24.9 <25"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "test:dsh": "pnpm build:test && node --test test/dsh-real.test.mjs",
    "test:host": "node scripts/test-host.mjs",
    "pack:bundle": "pnpm build && node -e \"require('fs').mkdirSync('dist-pack',{recursive:true})\" && cd bundle && pnpm pack --pack-destination ../dist-pack",
    "build:zhizhang": "tsc -p tsconfig.adapter.json && tsc -p packages/zhizhang/tsconfig.json && node packages/zhizhang/scripts/build-client.mjs",
    "build:test": "pnpm build:zhizhang && tsc -p tsconfig.test.json && node scripts/link-test-zhizhang.mjs",
    "guard": "node scripts/architecture-guard.mjs",
    "typecheck": "pnpm build:zhizhang && tsc -p tsconfig.json --noEmit",
    "test:rules": "python packages/toutiao/skill/tests/test_gates.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@11.25.0"
}
