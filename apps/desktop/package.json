{
  "name": "@writer/desktop",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && node ../../scripts/stage-desktop.mjs && electron-vite build",
    "pack": "node ../../scripts/prepare-desktop-python.mjs && electron-builder --win nsis --x64",
    "predev": "node ../../scripts/stage-desktop.mjs",
    "pack:portable": "node ../../scripts/prepare-desktop-python.mjs && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.0"
  },
  "description": "独立写作客户端：今日头条与番茄长篇",
  "author": "writer-agent contributors",
  "license": "UNLICENSED"
}
