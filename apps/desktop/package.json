{
  "name": "@writer/desktop",
  "version": "1.1.0-preview.3",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && node ../../scripts/stage-desktop.mjs && electron-vite build",
    "pack": "node ../../scripts/prepare-desktop-python.mjs && electron-builder --win nsis --x64 --publish never",
    "predev": "node ../../scripts/stage-desktop.mjs",
    "pack:portable": "node ../../scripts/prepare-desktop-python.mjs && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "docx": "^9.15.1",
    "electron-updater": "^6.8.11",
    "typebox": "^1.3.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.3.0"
  },
  "description": "独立写作客户端：今日头条与番茄长篇",
  "author": "writer-agent contributors",
