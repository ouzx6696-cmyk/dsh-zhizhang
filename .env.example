# 织章 Web 预览服务可选环境变量配置（不要在此填入真实密钥）

# 监听地址与端口（默认 0.0.0.0:3000）
HOST=0.0.0.0
PORT=3000

# Web 预览访问口令（留空表示本地免口令；设置后访问 /api/rpc、/api/events、/api/exports 需先输入口令）
ZHIZHANG_WEB_PASSCODE=

# Web 预览模式下是否允许模型连接指向本机或内网地址（127.0.0.1 / 192.168.x.x 等）
# 默认关闭以防护云端/共享部署访问内网与云元数据地址；仅在纯本机调试 Ollama 时设为 1
ZHIZHANG_ALLOW_PRIVATE_MODEL_ENDPOINTS=0
