{
  "schemaVersion": 2,
  "note": "织章内置写作方法与规则资产的来源登记。修改后请运行 npm run assets -- manifest，并用 npm run assets -- check 校验。",
  "sources": [
    {
      "id": "toutiao-viral-writer",
      "title": "今日头条写作方法、语料、模板与质检规则",
      "mode": "toutiao",
      "kind": "upstream",
      "version": "4.0.0",
      "dest": "packages/toutiao/skill",
      "upstreamRoot": "toutiao-viral-writer",
      "marker": "SKILL.md",
      "versionFrom": {
        "file": "SKILL.md",
        "pattern": "全链路写作（(\\d+\\.\\d+\\.\\d+)）"
      },
      "versionRefs": [],
      "local": [
        "scripts/writer_bridge.py"
      ],
      "patched": [
        "scripts/ledger.py",
        "scripts/qa_check.py",
        "tests/test_gates.py",
        "tests/test_bridge.py"
      ],
      "exclude": []
    },
    {
      "id": "inspiration-forge-suite",
      "title": "长篇规划、拆书、正文写作与编辑方法（forge 三件套）",
      "mode": "fanqie",
      "kind": "upstream",
      "version": "1.3.0",
      "dest": "packages/fanqie/skill/forge",
      "upstreamRoot": "inspiration-forge-suite",
      "marker": "novel-writer/SKILL.md",
      "versionFrom": {
        "file": "novel-writer/SKILL.md",
        "pattern": "version: \"(\\d+\\.\\d+\\.\\d+)\""
      },
      "versionRefs": [],
      "registry": {
        "type": "forge-tree"
      },
      "local": [],
      "patched": [
        "inspiration-forge-library/scripts/quote_check.py",
        "inspiration-forge-library/scripts/novel_scanner.py"
      ],
      "exclude": []
    },
    {
      "id": "toutiao-default-profile",
      "title": "今日头条默认方法方案（含 stage-map.json 阶段映射）",
      "mode": "toutiao",
      "kind": "profile",
      "dest": "packages/toutiao/profiles/default",
      "tool": "toutiao_read_method"
    },
    {
      "id": "fanqie-default-profile",
      "title": "番茄长篇默认方法方案（含 stage-map.json 阶段映射）",
      "mode": "fanqie",
      "kind": "profile",
      "dest": "packages/fanqie/profiles/default",
      "tool": "fanqie_read_method"
    },
    {
      "id": "zhizhang-fanqie-rules",
      "title": "番茄长篇本地规则与测试脚本",
      "mode": "fanqie",
      "kind": "local",
      "dest": "packages/fanqie/skill",
      "exclude": [
        "forge/"
      ]
    }
  ],
  "user": {
    "note": "作者自定义方法方案放在状态目录 profiles/<mode>/<id>/，运行时覆盖内置默认方案，不进入仓库清单。",
    "prefix": "user:",
    "exts": [
      ".md",
      ".txt",
      ".json"
    ]
  }
}
