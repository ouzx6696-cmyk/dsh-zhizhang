{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": [
      "node"
    ],
    "rootDir": "packages",
    "outDir": "build"
  },
  "include": [
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "packages/zhizhang"
  ]
}
